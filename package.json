{
  "name": "n8n-nodes-edit-image-plus",
  "version": "0.2.0",
  "description": "N8N Edit Image Plus — Advanced image editing with Sharp, templates, effects and more",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "node",
    "no-code",
    "n8n-nodes-edit-image-plus",
    "n8n-community-nodes-edit-image-plus",
    "image",
    "sharp",
    "template"
  ],
  "license": "MIT",
  "homepage": "https://unilogica.com",
  "author": {
    "name": "Allyson de Paula",
    "email": "depaula@unilogica.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/unilogica/n8n-edit-image-plus.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes --write",
    "lint": "eslint nodes package.json",
    "lintfix": "eslint nodes package.json --fix",
    "prepublishOnly": "npm run build && npm run lint -c .eslintrc.prepublish.js nodes package.json"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/nodes/EditImagePlus/EditImagePlus.node.js"
    ]
  },
  "dependencies": {
    "sharp": "^0.33.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.6",
    "@types/sharp": "^0.31.1",
    "@typescript-eslint/parser": "~5.45",
    "eslint-plugin-n8n-nodes-base": "^1.11.0",
    "gulp": "^4.0.2",
    "n8n-workflow": "^1.73.0",
    "prettier": "^2.7.1",
    "typescript": "~4.8.4"
  }
}
