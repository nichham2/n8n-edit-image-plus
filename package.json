{
  "name": "n8n-nodes-edit-image-pro",
  "version": "0.2.13",
  "description": "Advanced image editing node for n8n — powered by Sharp (libvips). Supports templates, text effects, watermarks, fonts, quote images, meme generation, drop shadows, glows, outlines, and 20+ image operations. No GraphicsMagick required.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "node",
    "no-code",
    "n8n-nodes-edit-image-pro",
    "image",
    "sharp",
    "template",
    "image-processing",
    "resize",
    "crop",
    "watermark",
    "social-media",
    "text-effects",
    "drop-shadow",
    "glow",
    "meme",
    "quote",
    "instagram",
    "youtube-thumbnail",
    "font",
    "typography",
    "graphic-design",
    "automation"
  ],
  "license": "MIT",
  "homepage": "https://github.com/nichham2/n8n-edit-image-plus#readme",
  "author": {
    "name": "nichham2",
    "url": "https://github.com/nichham2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nichham2/n8n-edit-image-plus.git"
  },
  "bugs": {
    "url": "https://github.com/nichham2/n8n-edit-image-plus/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://www.paypal.com/donate/?hosted_button_id=6MJYVDTM95MC4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "index.js",
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes --write",
    "lint": "eslint nodes package.json",
    "lintfix": "eslint nodes package.json --fix",
    "test": "node test/run-tests.js",
    "prepublishOnly": "npm run build && npm run lint && npm test",
    "release:patch": "npm version patch && npm publish",
    "release:minor": "npm version minor && npm publish",
    "release:major": "npm version major && npm publish"
  },
  "files": [
    "dist",
    "index.js",
    "README.md",
    "LICENSE.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/nodes/EditImagePlus/EditImagePlus.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": ">=1.0.0"
  },
  "dependencies": {
    "sharp": "^0.33.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/parser": "~5.45",
    "eslint": "^8.57.1",
    "eslint-plugin-n8n-nodes-base": "^1.11.0",
    "gulp": "^5.0.1",
    "n8n-workflow": "^2.16.0",
    "prettier": "^2.7.1",
    "typescript": "~5.8.2"
  }
}
